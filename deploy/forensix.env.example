# Copy to .env (Compose) or load into a Kubernetes Secret. Never commit the real file.
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FORENSIX_SERVER_API_KEY=change-me
FORENSIX_SERVER_ADMIN_KEY=change-me-too

# Optional overrides (any ServerConfig field works as FORENSIX_SERVER_<FIELD>)
# FORENSIX_PRELOAD=commfor dfdet-clip
# FORENSIX_SERVER_MAX_LOADED=6
# FORENSIX_SERVER_THRESHOLDS={"dfdet-clip": 0.71}
# LOG_FORMAT=json
# OMP_NUM_THREADS=4
